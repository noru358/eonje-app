# 서울 열린데이터광장 인증키
SEOUL_API_KEY=

# 공공데이터포털 기상청 단기예보 키 (선택)
DATA_GO_KR_API_KEY=

# 대기질 예보 검증용 shadow provider.
# 현재 지원: open-meteo
# shadow 데이터는 public verdict/scoring에 반영하지 않음.
# 실제 서비스 이용 전 provider의 라이선스/표시 요건을 별도로 확인할 것.
AQ_SHADOW_PROVIDER=

# 추천 품질 검증용 원천 스냅샷 저장 (0/1)
STORE_SNAPSHOTS=0

# 기본: data/snapshots
# SNAPSHOT_DIR=

# 기본: 4173
# PORT=4173
